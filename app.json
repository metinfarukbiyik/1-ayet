{
  "expo": {
    "name": "1 Ayet",
    "slug": "1ayet",
    "version": "1.0.0",
    "owner": "metinbiyik",
    "orientation": "portrait",
    "icon": "./assets/images/birayet.png",
    "scheme": "birayet",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/birayet.png",
      "bundleIdentifier": "dev.biyik.birayet",
      "buildNumber": "1",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "mailto"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.biyik.birayet",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D483E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D483E",
          "image": "./assets/images/birayet.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0A2A22"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.dev.biyik.birayet",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "DailyVerseWidget",
              "displayName": "Günün Ayeti",
              "description": "Günün ayetini ve tefekkür duasını ana ekranınızda görüntüleyin.",
              "supportedFamilies": ["systemSmall", "systemMedium", "systemLarge"],
              "contentMarginsDisabled": false,
              "android": {
                "minWidth": 140,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1b5c5ed-a02b-4271-aceb-c307b77944de"
      }
    }
  }
}
